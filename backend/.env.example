PORT=5000
MONGO_URI=your_mongodb_uri_here
JWT_SECRET=your_jwt_secret_at_least_16_chars_long
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,https://edustride.in
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_hmac_secret_here

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email_user_here
EMAIL_PASS=your_email_pass_here

# Brevo config (used for Brevo HTTP API in production)
BREVO_PASS=your_brevo_api_key_here
BREVO_SENDER=your_verified_sender_email_here

# Cloudinary Config (Uncomment and fill to enable Cloud Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Optional: Automated SMS / WhatsApp Webhook for Biometric Gate Entry/Exit Parent Alerts
# GATE_SMS_WEBHOOK_URL=https://your-sms-or-whatsapp-gateway-endpoint
# GATE_SMS_WEBHOOK_TOKEN=your_bearer_token_here
